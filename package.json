{
  "name": "ofeminin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "vite build --mode electron && electron .",
    "dist:win": "vite build --mode electron && electron-builder --win --x64"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.19.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "main": "electron/main.cjs",
  "productName": "Au Féminin",
  "description": "Au Féminin — suivi du cycle et de la grossesse",
  "author": "Dr. Hédi Belhoula",
  "build": {
    "appId": "com.belhoula.aufeminin",
    "productName": "Au Féminin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "AuFeminin-Setup-${version}.exe",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
